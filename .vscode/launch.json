    "version": "0.2.0",
    "configurations": [
        {
            "name": "Curr File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [
                "tui"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "LangCode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "args": [
                "tui"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
        }
    ]
}
